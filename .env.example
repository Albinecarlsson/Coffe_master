
### `.env.example`

# sim = in-memory thermal simulator (no hardware needed)
# rtd = real MAX31865 RTD sensor (Raspberry Pi; heater/valve not implemented yet)
HARDWARE_MODE=sim

SIM_AMBIENT_C=22.0
SIM_INITIAL_WATER_C=25.0
CONTROL_LOOP_HZ=10

# --- MAX31865 RTD sensor (HARDWARE_MODE=rtd) ---
# RTD nominal resistance in ohms: 100 for PT100, 1000 for PT1000
RTD_R0_OHMS=100.0
# Reference resistor on the breakout: 430 for Adafruit's PT100 board,
# 4300 for the PT1000 board
RTD_RREF_OHMS=430.0
# Number of probe wires: 2, 3 or 4 (3 enables lead-resistance compensation)
RTD_WIRES=2
# Mains rejection filter: 50 (Europe) or 60 (US)
RTD_FILTER_HZ=60
# SPI bus and chip-select device
RTD_SPI_BUS=0
RTD_SPI_DEVICE=0

# --- GPIO actuators (HARDWARE_MODE=rtd) ---
# BCM pin numbers
HEATER_GPIO_PIN=17
VALVE_GPIO_PIN=27
# Set to false for active-low relay/valve driver boards
HEATER_ACTIVE_HIGH=true
VALVE_ACTIVE_HIGH=true
# Time-proportioning window for the solid state relay, in seconds
HEATER_WINDOW_S=1.0
