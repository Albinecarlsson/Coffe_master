
### `.env.example`

# sim = in-memory thermal simulator (no hardware needed)
# rtd = real hardware: MAX31865 RTD sensor + GPIO heater, valve and pump
HARDWARE_MODE=sim

SIM_AMBIENT_C=22.0
SIM_INITIAL_WATER_C=25.0
CONTROL_LOOP_HZ=10

# --- MAX31865 RTD sensor (HARDWARE_MODE=rtd) ---
# RTD nominal resistance in ohms: 100 for PT100, 1000 for PT1000
RTD_R0_OHMS=100.0
# Reference resistor on the breakout: 430 for Adafruit's PT100 board,
# 4300 for the PT1000 board
RTD_RREF_OHMS=430.0
# Number of probe wires: 2, 3 or 4 (3 enables lead-resistance compensation)
RTD_WIRES=2
# Mains rejection filter: 50 (Europe) or 60 (US)
RTD_FILTER_HZ=60
# SPI bus and chip-select device
RTD_SPI_BUS=0
RTD_SPI_DEVICE=0

# --- GPIO actuators (HARDWARE_MODE=rtd) ---
# BCM pin numbers
HEATER_GPIO_PIN=17
VALVE_GPIO_PIN=27
PUMP_GPIO_PIN=22
# Set to false for active-low relay/valve driver boards
HEATER_ACTIVE_HIGH=true
VALVE_ACTIVE_HIGH=true
PUMP_ACTIVE_HIGH=true
# Time-proportioning window for the solid state relay, in seconds
HEATER_WINDOW_S=1.0

# --- Preinfusion ---
# End each pump burst once brew pressure reaches this many bar (0 keeps the fixed
# timed pulse). Needs a healthy pressure sender; a fault changes nothing.
PREINFUSION_TARGET_BAR=2.0

# --- Brew pressure sensor (HARDWARE_MODE=rtd) ---
# 0-16 bar ratiometric sender (0.5-4.5 V) through an ADS1115 over I2C. Set to
# false while the sender is not fitted yet: the UI shows a dash, not a fake zero.
PRESSURE_ENABLED=true
PRESSURE_I2C_BUS=1
# ADS1115 address: 0x48 with ADDR tied to GND, 0x49-0x4B otherwise
PRESSURE_I2C_ADDRESS=0x48
# Single-ended input AIN0..AIN3
PRESSURE_ADS_CHANNEL=0
# The sender's electrical span
PRESSURE_BAR_MAX=16.0
PRESSURE_VOLTS_MIN=0.5
PRESSURE_VOLTS_MAX=4.5
# Sender volts divided by ADC volts: 2.0 for a 10k/10k divider
PRESSURE_DIVIDER=2.0
# ADS1115 programmable-gain full scale in volts (4.096 covers a halved 4.5 V)
PRESSURE_ADS_PGA=4.096
# Conversions per second: 8, 16, 32, 64, 128, 250, 475 or 860
PRESSURE_ADS_DATA_RATE=128

# --- Dosing ---
# Calibrated brew flow for this machine, in ml/s. Time a pour into a cup on a
# scale and divide millilitres by seconds. Everything else scales from here.
BREW_FLOW_ML_S=1.1
# How close to the setpoint the boiler must be before a pour is allowed (°C)
READY_TOLERANCE_C=2.0

# --- History ---
# SQLite file for every finished shot and pour. Created on first use.
HISTORY_DB_PATH=data/history.db
